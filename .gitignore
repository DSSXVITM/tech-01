# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
ai-tech-news-platform-build.json
wrangler-dev.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.err

# env files (can opt-in for committing if needed)
.env*
!.env.example

# corrupt git dir kept for reference
/.git-corrupt/

# vercel
.vercel

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars

# local dev database + generated seeds
.data/
db/seeds/
dev-server.log

# typescript
*.tsbuildinfo
next-env.d.ts
