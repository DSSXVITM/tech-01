# Local environment — gitignored, but kept secret-free so GitHub push
# protection never flags it. Supply the real values at runtime instead:
#
#   Local (PowerShell, before npm run dev):
#     $env:GOOGLE_CLIENT_ID="PASTE_YOUR_CLIENT_ID_HERE"
#     $env:GOOGLE_CLIENT_SECRET="PASTE_YOUR_CLIENT_SECRET_HERE"
#
#   Production (Cloudflare — stored as a secret, not in any file):
#     npx wrangler login
#     npx wrangler secret put GOOGLE_CLIENT_ID
#     npx wrangler secret put GOOGLE_CLIENT_SECRET
#
# When these are empty the Google button simply does not render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
